# Rhythm Flutter Environment Variables Sample

# Base API domain URL (without language or api/v1 prefix)
# Examples:
# For local Android Emulator:
# BASE_URL=http://10.0.2.2:8000
#
# For Web / Windows / macOS / Linux Desktop:
# BASE_URL=http://localhost:8000
#
# For Physical Android / iOS device (use your PC's local network IP):
# BASE_URL=http://192.168.1.100:8000
#
# For Production / Staging server:
BASE_URL=https://dev.example.com
